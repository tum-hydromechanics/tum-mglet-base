        "snapshot_step": 1,
        "list_length": 1000,
        "do_advection": false,
        "do_diffusion": true, 
        "random_walk_mode": "gaussian2",
        "truncation_limit": 2.0,
        "D":[0.002, 0.002, 0.0]
