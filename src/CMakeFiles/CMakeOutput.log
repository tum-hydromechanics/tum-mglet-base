MODULE elemental_mod

    IMPLICIT NONE(type, external)
    PUBLIC :: af, bf

CONTAINS

    ELEMENTAL SUBROUTINE af(a, b)
        REAL, INTENT(inout) :: a, b
        a = a + b
    END SUBROUTINE af

    PURE ELEMENTAL REAL FUNCTION bf(a, b) RESULT(res)
        REAL, INTENT(in) :: a, b
        res = a + b
    END FUNCTION bf

END MODULE elemental_mod

